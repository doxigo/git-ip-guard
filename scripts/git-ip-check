#!/bin/bash

# git-ip-check: checks the public IP's location against the config. Exit 0 = allowed.
# Usage: git-ip-check [config.json] [push|pull]
# The config defaults to ~/.config/git-ip-guard/config.json. v2 per-repo hooks still
# call this with their own config path first, so that form keeps working.

set -u

for _lib in "$(dirname "${BASH_SOURCE[0]}")/lib/ip-common.sh" "$HOME/.local/share/git-ip-guard/lib/ip-common.sh"; do
    [ -r "$_lib" ] && break
done
# shellcheck source=lib/ip-common.sh
. "$_lib" 2>/dev/null || { echo "git-ip-guard: ip-common.sh not found. Reinstall git-ip-guard." >&2; exit 1; }

config="$GIT_IP_GUARD_CONFIG"
case "${1:-}" in *.json) config="$1"; shift ;; esac
op="${1:-push}"
case "$op" in
    push) Op="Push" ;;
    pull) Op="Pull" ;;
    *) echo "Usage: git-ip-check [config.json] [push|pull]" >&2; exit 2 ;;
esac

# Append one line to the configured log file; failures are silent.
log_event() {
    local path
    path=$(expand_tilde "$(jq -r '.log_file // "~/.git_ip_error.log"' "$config" 2>/dev/null)")
    mkdir -p "$(dirname "$path")" 2>/dev/null
    printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >> "$path" 2>/dev/null
}

if [ "${IPCHECK_BYPASS:-}" = "1" ]; then
    echo -e "${YELLOW}⚠️  IP check bypassed via IPCHECK_BYPASS${NC}"
    exit 0
fi

# ipcheck.global.disable, ipcheck.disable or ipcheck.<op>.disable, in global or repo config.
disabled=$(git config --type=bool --show-scope --get-regexp '^ipcheck\.' 2>/dev/null | awk -v op="$op" '
    $3 == "true" && ($2 == "ipcheck.global.disable" || $2 == "ipcheck.disable" || $2 == "ipcheck." op ".disable") {
        print $2 " (" $1 " config)"; exit
    }')
if [ -n "$disabled" ]; then
    echo -e "${YELLOW}⚠️  IP check disabled by $disabled${NC}"
    exit 0
fi

# jq's `//` treats false like null, so compare instead.
enabled=$(jq -r --arg op "$op" '.["enable_\($op)_check"] != false' "$config" 2>/dev/null) || {
    echo -e "${RED}Error: config missing or not valid JSON: $config${NC}"
    exit 1
}
if [ "$enabled" = "false" ]; then
    echo -e "${YELLOW}⚠️  $Op checks are disabled in $config${NC}"
    exit 0
fi

if ! ip_info=$(get_ip_info "$config"); then
    echo -e "${RED}Error: Could not detect IP information from any provider.${NC}"
    echo -e "${RED}Operation blocked because location is unverifiable.${NC}"
    echo -e "${YELLOW}Set GIT_IP_GUARD_VERBOSE=1 to see provider errors,${NC}"
    echo -e "${YELLOW}or use IPCHECK_BYPASS=1 git ${op} to bypass.${NC}"
    log_event "$Op blocked: no IP provider responded"
    exit 1
fi

IFS=$'\x1f' read -r verdict country city region ip <<< "$(ip_guard_verdict "$config" "$ip_info")"
flag=$(get_flag "$country")

case "${verdict:-}" in
    allowed)
        printf '%s✅ Location verified: %s %s - %s allowed%s\n' "$GREEN" "$flag" "$country" "$Op" "$NC"
        exit 0
        ;;
    not-allowed) reason="$flag $country is not on the allowed list" ;;
    blocked)     reason="access denied from sanctioned country $flag $country" ;;
    region:*)    reason="sanctioned region ${verdict#region:} ($flag $country)" ;;
    *)
        echo -e "${RED}Error: Could not determine the country from the IP lookup.${NC}"
        echo -e "${RED}Operation blocked because location is unverifiable.${NC}"
        log_event "$Op blocked: no valid country code from provider"
        exit 1
        ;;
esac
# Provider text goes through %s, never echo -e, so it can't smuggle in escapes.
printf '%s⛔ %s blocked: %s%s\n' "$RED" "$Op" "$reason" "$NC"
[ "$region" = "$city" ] && region=""
printf '%sIP: %s, Location: %s %s%s, %s%s\n' "$YELLOW" "${ip:-unknown}" "$flag" "${city:-Unknown}" "${region:+, $region}" "$country" "$NC"
log_event "$Op blocked from $country: $verdict (ip=${ip:-unknown})"
exit 1
