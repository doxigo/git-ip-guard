#!/bin/bash

# git-ip-control: show and change Git IP Guard settings.

GREEN=$'\033[0;32m'
RED=$'\033[0;31m'
YELLOW=$'\033[0;33m'
BLUE=$'\033[0;34m'
CYAN=$'\033[0;36m'
BOLD=$'\033[1m'
NC=$'\033[0m'

HOME_DIR="$HOME/.local/share/git-ip-guard"
CONFIG="$HOME/.config/git-ip-guard/config.json"

show_usage() {
    cat <<USAGE
${CYAN}${BOLD}git-ip-control${NC} - Manage Git IP Guard settings

${BOLD}Usage:${NC}
  git-ip-control status
  git-ip-control enable|disable [--global|--repo] [--push|--pull]

Without --global or --repo, enable/disable apply to the current repository
(or globally when you're not in one).

${BOLD}Examples:${NC}
  git-ip-control disable --global
  git-ip-control disable --repo --push
  git-ip-control enable --global --pull
USAGE
}

state() { [ "$1" = "true" ] && echo "${RED}DISABLED${NC}" || echo "${GREEN}enabled${NC}"; }

show_status() {
    echo "${CYAN}${BOLD}Git IP Guard Status${NC}"
    echo ""
    echo "${BLUE}Global:${NC}"
    echo "  All operations:  $(state "$(git config --global --type=bool --get ipcheck.global.disable)")"
    echo "  Push:            $(state "$(git config --global --type=bool --get ipcheck.push.disable)")"
    echo "  Pull:            $(state "$(git config --global --type=bool --get ipcheck.pull.disable)")"
    if git rev-parse --git-dir >/dev/null 2>&1; then
        echo ""
        echo "${BLUE}Repository:${NC} $(git rev-parse --show-toplevel)"
        echo "  All operations:  $(state "$(git config --local --type=bool --get ipcheck.disable)")"
        echo "  Push:            $(state "$(git config --local --type=bool --get ipcheck.push.disable)")"
        echo "  Pull:            $(state "$(git config --local --type=bool --get ipcheck.pull.disable)")"
        local hooks_dir
        hooks_dir=$(git rev-parse --git-path hooks)
        if grep -qs 'git-ip-guard' "$hooks_dir/pre-push"; then
            echo "  Hooks:           ${GREEN}installed${NC}"
        elif grep -qs 'git-ip-check' "$hooks_dir/pre-push"; then
            echo "  Hooks:           ${YELLOW}v2 (run apply-to-existing-repos.sh to update)${NC}"
        else
            echo "  Hooks:           ${YELLOW}not installed (SSH remotes are still checked)${NC}"
        fi
    fi
    echo ""
    echo "${BLUE}Installation:${NC}"
    if [ -x "$HOME_DIR/git-ip-check" ]; then
        echo "  Scripts:         ${GREEN}$HOME_DIR${NC}"
    else
        echo "  Scripts:         ${RED}not installed${NC}"
    fi
    if [ -f "$CONFIG" ]; then
        echo "  Config:          ${GREEN}$CONFIG${NC} (mode $(jq -r '.mode // "blocklist"' "$CONFIG" 2>/dev/null))"
    else
        echo "  Config:          ${RED}missing${NC}"
    fi
    case "$(git config --get core.sshCommand)" in
        *git-ip-guard-ssh*) echo "  SSH check:       ${GREEN}on${NC}" ;;
        *) echo "  SSH check:       ${YELLOW}off (core.sshCommand is set elsewhere, or not installed)${NC}" ;;
    esac
    [ -n "${GIT_SSH_COMMAND:-}${GIT_SSH:-}" ] && \
        echo "  ${YELLOW}GIT_SSH_COMMAND/GIT_SSH is set in this shell, so SSH checks are skipped here.${NC}"
}

# set_disable <true|unset> <scope> <operation>
set_disable() {
    local action="$1" scope="$2" op="$3" flag=--global key
    if [ "$scope" = "repo" ]; then
        git rev-parse --git-dir >/dev/null 2>&1 || { echo "${RED}Error: Not in a git repository${NC}"; return 1; }
        flag=--local
    fi
    # The all-operations key is ipcheck.global.disable globally and ipcheck.disable in a repo.
    if [ -n "$op" ]; then
        key="ipcheck.$op.disable"
    elif [ "$scope" = "global" ]; then
        key=ipcheck.global.disable
    else
        key=ipcheck.disable
    fi
    if [ "$action" = "true" ]; then
        git config "$flag" "$key" true
        echo "${YELLOW}⚠️  ${op:-All} checks disabled ($scope)${NC}"
    else
        git config "$flag" --unset "$key" 2>/dev/null
        # Enabling everything also clears the per-operation switches.
        [ -z "$op" ] && git config "$flag" --unset ipcheck.push.disable 2>/dev/null
        [ -z "$op" ] && git config "$flag" --unset ipcheck.pull.disable 2>/dev/null
        echo "${GREEN}✅ ${op:-All} checks enabled ($scope)${NC}"
    fi
}

COMMAND="" SCOPE="" OPERATION=""
while [ $# -gt 0 ]; do
    case $1 in
        status|enable|disable) COMMAND="$1" ;;
        --global) SCOPE="global" ;;
        --repo) SCOPE="repo" ;;
        --push) OPERATION="push" ;;
        --pull) OPERATION="pull" ;;
        --help|-h) show_usage; exit 0 ;;
        *) echo "${RED}Unknown option: $1${NC}"; echo ""; show_usage; exit 1 ;;
    esac
    shift
done

if [ -z "$SCOPE" ]; then
    git rev-parse --git-dir >/dev/null 2>&1 && SCOPE="repo" || SCOPE="global"
fi

case "$COMMAND" in
    status) show_status ;;
    enable) set_disable unset "$SCOPE" "$OPERATION" ;;
    disable) set_disable true "$SCOPE" "$OPERATION" ;;
    *) show_usage; exit 1 ;;
esac
