#!/bin/bash

# git-ip-info: display current IP, location, git identity, and IP Guard status.

set -u

for _lib in "$(dirname "${BASH_SOURCE[0]}")/lib/ip-common.sh" "$HOME/.local/share/git-ip-guard/lib/ip-common.sh"; do
    [ -r "$_lib" ] && break
done
# shellcheck source=lib/ip-common.sh
. "$_lib" 2>/dev/null || { echo "git-ip-guard: ip-common.sh not found. Reinstall git-ip-guard." >&2; exit 1; }

for arg in "$@"; do
    case "$arg" in
        -v|--verbose) export GIT_IP_GUARD_VERBOSE=1 ;;
        --no-cache) export IPCHECK_NO_CACHE=1 ;;
        -h|--help)
            cat <<USAGE
Usage: git-ip-info [--verbose] [--no-cache]
  --verbose     Show provider attempts and errors.
  --no-cache    Bypass the local IP cache for this run.
USAGE
            exit 0
            ;;
    esac
done

rule="${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
# label value [color]: provider and git config text is printed with %s, never interpreted.
row() { printf '  %s%-12s%s %s%s%s\n' "$BOLD" "$1" "$NC" "${3:-$GREEN}" "$2" "$NC"; }

echo -e "${CYAN}${BOLD}╔═══════════════════════════════════════════════════════════╗${NC}"
echo -e "${CYAN}${BOLD}║                  Git & IP Information                     ║${NC}"
echo -e "${CYAN}${BOLD}╚═══════════════════════════════════════════════════════════╝${NC}"
echo ""

# --- Git identity --------------------------------------------------------------
echo -e "${BLUE}${BOLD}Git Configuration:${NC}"
echo "$rule"
identity() {
    local value
    value=$(git config --get "user.$1" 2>/dev/null)
    if [ -z "$value" ]; then
        row "$2" "Not configured" "$RED"
    elif [ -n "$(git config --local --get "user.$1" 2>/dev/null)" ]; then
        row "$2" "$value (this repository)"
    else
        row "$2" "$value"
    fi
}
identity name "User Name:"
identity email "User Email:"
echo ""

# --- IP info -------------------------------------------------------------------
echo -e "${BLUE}${BOLD}IP & Location Information:${NC}"
echo "$rule"

if ! IP_INFO=$(get_ip_info "$GIT_IP_GUARD_CONFIG"); then
    echo -e "${RED}  ❌ Could not fetch IP information from any provider.${NC}"
    echo -e "${YELLOW}  Run with --verbose to see provider attempts:${NC}"
    echo -e "      git-ip-info --verbose --no-cache"
    exit 1
fi

IFS=$'\x1f' read -r IP COUNTRY COUNTRY_NAME CITY REGION ORG TIMEZONE PROVIDER <<< "$(printf '%s' "$IP_INFO" | jq -r '
    [.ip, .country, .country_name, .city, .region, .org, .timezone, .provider] | map(. // "") | join("\u001f")')"
FLAG=$(get_flag "$COUNTRY")
{ [ -z "$COUNTRY_NAME" ] || [ "$COUNTRY_NAME" = "$COUNTRY" ]; } && COUNTRY_NAME=$(get_country_name "$COUNTRY")

LOCATION="$CITY"
[ -n "$REGION" ] && [ "$REGION" != "$CITY" ] && LOCATION="${LOCATION:+$LOCATION, }$REGION"
[ -n "$COUNTRY_NAME" ] && LOCATION="${LOCATION:+$LOCATION, }$COUNTRY_NAME"
row "IP Address:" "${IP:-unknown}"
row "Location:" "$FLAG $LOCATION"
[ -n "$ORG" ]      && row "ISP/Org:" "$ORG"
[ -n "$TIMEZONE" ] && row "Timezone:" "$TIMEZONE"
[ -n "$PROVIDER" ] && row "Source:" "$PROVIDER" "$CYAN"
echo ""

# --- Guard status --------------------------------------------------------------
echo -e "${BLUE}${BOLD}Git IP Guard Status:${NC}"
echo "$rule"

if [ ! -f "$GIT_IP_GUARD_CONFIG" ]; then
    echo -e "  ${YELLOW}Git IP Guard is not installed (no $GIT_IP_GUARD_CONFIG).${NC}"
elif ! VERDICT=$(ip_guard_verdict "$GIT_IP_GUARD_CONFIG" "$IP_INFO"); then
    echo -e "  ${RED}Config is not valid JSON: $GIT_IP_GUARD_CONFIG${NC}"
else
    MODE=$(jq -r '.mode // "blocklist"' "$GIT_IP_GUARD_CONFIG")
    case "${VERDICT%%$'\x1f'*}" in
        allowed)
            printf '  %s✅ Your location (%s %s) is allowed under mode=%s.%s\n' "$GREEN" "$FLAG" "$COUNTRY_NAME" "$MODE" "$NC" ;;
        *)
            printf '  %s⛔ Your location (%s %s) would be blocked under mode=%s.%s\n' "$RED" "$FLAG" "$COUNTRY_NAME" "$MODE" "$NC"
            echo -e "  ${YELLOW}Git push/pull operations will fail from this location.${NC}" ;;
    esac
    [ "${IPCHECK_BYPASS:-}" = "1" ] && echo -e "  ${YELLOW}⚠️  IPCHECK_BYPASS is set in this environment.${NC}"
    git config --type=bool --show-scope --get-regexp '^ipcheck\..*disable$' 2>/dev/null | while read -r scope key value; do
        [ "$value" = "true" ] && echo -e "  ${YELLOW}⚠️  $key is set ($scope config).${NC}"
    done
fi

echo ""
echo "$rule"
echo -e "${MAGENTA}Generated at: $(date '+%Y-%m-%d %H:%M:%S %Z')${NC}"
